<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nss</groupId>
    <artifactId>nss-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>nss-controller</artifactId>
  <name>nss-controller</name>
  <description>Controller: bien REST cua he thong.</description>

  <dependencies>
    <dependency>
      <groupId>com.nss</groupId>
      <artifactId>nss-application</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- jakarta.validation cho @Valid @RequestBody; spring-boot-starter-web KHONG keo theo tu Boot 2.3 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- Swagger / OpenAPI 3: dat o day vi controller la noi duy nhat mang annotation doc.
         Version pin o root pom (BOM spring-boot-dependencies khong quan springdoc).
         KHONG duoc keo xuong nss-application / nss-domain - dao chieu phu thuoc (architecture muc 1). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>
    <!-- Spring Security (backlog 0010, ADR 0003): SecurityFilterChain va bo giai JWT cua resource
         server song o day, cung cho voi spring-boot-starter-web.
         Ca hai nam trong BOM spring-boot-dependencies 3.3.5 nen KHONG khai <version> va KHONG them
         property phien ban nao — dung ly do ADR 0003 chon chung thay vi jjwt.
         Khai tuong minh du oauth2-resource-server da den transitively tu nss-application: module
         nao dung thi module do khai. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
  </dependencies>
</project>

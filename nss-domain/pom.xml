<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nss</groupId>
    <artifactId>nss-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>nss-domain</artifactId>
  <name>nss-domain</name>
  <description>Domain: entity, port (repository interface), domain service. Khong phu thuoc module nao.</description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- Domain la noi duy nhat khai spring-boot-starter-data-jpa phia domain (coding-conventions.md muc 6).
         Day la thu vien, khong phai module com.nss, nen enforcer ban com.nss:* van xanh. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!-- PasswordEncoder cho AuthDomainService (backlog 0010): bam va doi chieu mat khau la quy tac
         nghiep vu chu khong phai chi tiet ha tang, nen no song o domain.
         KHONG phai spring-boot-starter-security: artifact nay la thu vien ma hoa THUAN, khong keo
         theo servlet filter hay SecurityFilterChain — nhung thu do o lai nss-controller.
         Day la thu vien, khong phai module com.nss, nen enforcer ban com.nss:* van xanh.
         Version do BOM spring-boot-dependencies 3.3.5 quan; khong khai <version>. -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Bat bien "domain khong phu thuoc module nao" tro thanh loi build, khong con la loi hua trong tai lieu -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-nss-module-dependencies</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <fail>true</fail>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>com.nss:*</exclude>
                  </excludes>
                  <message>nss-domain khong duoc phu thuoc bat ky module com.nss nao (architecture/01-overview.md muc 1)</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

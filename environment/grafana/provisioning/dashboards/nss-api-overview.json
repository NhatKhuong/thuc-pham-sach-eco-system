{
  "id": null,
  "uid": "nss-api-overview",
  "title": "NSS API — Overview (dev)",
  "description": "Dashboard dung san cho backend nss-api (backlog 0038): JVM, HTTP, Hikari pool, RateLimiter 3 tier va CircuitBreaker SMTP (backlog 0021).",
  "tags": ["nss-api", "backlog-0038"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "JVM Heap Used",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "jvm_memory_used_bytes{application=\"nss-event-api\", area=\"heap\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "JVM Threads Live",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{application=\"nss-event-api\"}",
          "legendFormat": "live threads",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{application=\"nss-event-api\"}",
          "legendFormat": "daemon threads",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "title": "JVM GC Pause Rate",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{application=\"nss-event-api\"}[5m])",
          "legendFormat": "{{action}} / {{cause}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Hikari Pool",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "hikaricp_connections_active{application=\"nss-event-api\"}",
          "legendFormat": "active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{application=\"nss-event-api\"}",
          "legendFormat": "idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_pending{application=\"nss-event-api\"}",
          "legendFormat": "pending",
          "refId": "C"
        },
        {
          "expr": "hikaricp_connections_max{application=\"nss-event-api\"}",
          "legendFormat": "max (100)",
          "refId": "D"
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP Request Rate theo endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"nss-event-api\"}[1m])) by (uri, status)",
          "legendFormat": "{{uri}} [{{status}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "HTTP Latency trung binh theo endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "description": "Latency trung binh (sum/count) — histogram percentile (p50/p95/p99) CHUA duoc bat o du an nay (khac du an tham chieu, architecture/01-overview.md §9), nen khong dung histogram_quantile o day.",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_sum{application=\"nss-event-api\"}[5m])) by (uri) / sum(rate(http_server_requests_seconds_count{application=\"nss-event-api\"}[5m])) by (uri)",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "RateLimiter — permit con lai theo tier",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "description": "Ba tier cua ApiRateLimitInterceptor (backlog 0021 Phase 1): auth/write/read. Sut sat ve 0 nghia la tier do dang chan bot request.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "resilience4j_ratelimiter_available_permissions{application=\"nss-event-api\"}",
          "legendFormat": "{{name}} — available",
          "refId": "A"
        },
        {
          "expr": "resilience4j_ratelimiter_waiting_threads{application=\"nss-event-api\"}",
          "legendFormat": "{{name}} — waiting",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "CircuitBreaker SMTP — state",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "description": "Breaker 'mail' quanh duong gui SMTP (backlog 0021 Phase 2). 1 = dang o state do, 0 = khong. closed=binh thuong, open=dang bo qua gui mail, half_open=dang tham do lai.",
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_state{application=\"nss-event-api\", name=\"mail\"}",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "CircuitBreaker SMTP — so lan goi (successful / failed / ignored)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "resilience4j_circuitbreaker_calls_seconds_count{application=\"nss-event-api\", name=\"mail\"}",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Purchase Request — tuoi cua PENDING cu nhat",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "description": "Gauge nghiep vu purchase_request_pending_age_seconds (backlog 0039 Phase 7): bat ca 'consumer treo nhung con song' ma kafka_consumer_fetch_manager_records_lag khong bat duoc (lag thap trong khi mot request khong bao gio resolve). Sut sat quanh 0 la binh thuong; tang lien tuc nghia co request PENDING dang bi ket.",
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "purchase_request_pending_age_seconds{application=\"nss-event-api\"}",
          "legendFormat": "oldest pending age",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Kafka Consumer Lag — purchase.requested",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus-nss-event" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "description": "kafka_consumer_fetch_manager_records_lag cho group nss-purchase-request (backlog 0039 Phase 7) — do duoc tu dong qua micrometer-core/spring-kafka, khong can cau hinh them.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "kafka_consumer_fetch_manager_records_lag{application=\"nss-event-api\"}",
          "legendFormat": "{{topic}} / partition {{partition}}",
          "refId": "A"
        }
      ]
    }
  ]
}

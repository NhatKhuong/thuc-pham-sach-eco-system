<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nss</groupId>
    <artifactId>nss-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>nss-application</artifactId>
  <name>nss-application</name>
  <description>Application: use case, dieu phoi giua domain va infrastructure.</description>

  <dependencies>
    <dependency>
      <groupId>com.nss</groupId>
      <artifactId>nss-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nss</groupId>
      <artifactId>nss-infrastructure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- JwtEncoder / JwtClaimsSet de duc access token trong AuthAppServiceImpl (backlog 0010).
         Vi sao o day chu khong chi o nss-controller nhu ticket ghi: Maven chi truyen dependency
         XUOI theo chieu phu thuoc. nss-controller -> nss-application, nen thu khai o controller
         KHONG co tren classpath bien dich cua application. Ma use case cap phien (register /
         login / refresh) song o application, nen module do phai tu khai.
         nss-controller van khai lai ca hai starter mot cach tuong minh cho filter chain.
         Ca hai nam trong BOM spring-boot-dependencies 3.3.5 — khong khai <version>. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- CHI annotation cua Jackson — khong phai databind, khong phai starter-json (backlog 0014
         phase 2).
         Vi sao module nay can no: cac lop *Response o day CHINH LA be mat day (ADR 0001 —
         controller tra DTO tran, khong boc ResultMessage), nen luat "truong nay VANG MAT khi khong
         ap dung" thuoc ve chinh dinh nghia cua DTO chu khong phai mot chi tiet cua tang HTTP.
         CartIssueResponse can @JsonInclude(NON_NULL) tren ba truong tuy chon: mot
         `availableStock: 0` gan tren issue price_changed la mot con so SAI, va con so sai thi
         frontend van hien thi duoc — no chi hien thi sai.
         KHONG dat NON_NULL toan cuc bang spring.jackson.default-property-inclusion: API_CONTRACT
         §A.5 bat "gia tri khong co" phai la `null` TUONG MINH, nen mot cau hinh toan cuc se lam
         `salePrice: null` cua ProductResponse bien mat va doi hinh dang cua type Product.
         Artifact nay chi mang annotation, khong keo theo bo tuan tu hoa nao; ban dich thuc su van
         den tu nss-controller qua spring-boot-starter-web. Version do BOM spring-boot-dependencies
         3.3.5 quan — khong khai <version>. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <!-- JavaMailSender cho MailAppServiceImpl (backlog 0017, ADR 0004). Day la lan MO RONG STACK
         that su: mail khong co ten trong bang stack architecture §2 o bat ky dang nao truoc ticket
         nay — khac Redis va Resilience4j, hai thu CO ten trong §2 nhung chua noi day.
         => architecture/01-overview.md §2 duoc cap nhat trong CUNG ticket nay.
         Vi sao SMTP chu khong phai mot dich vu HTTP ben ngoai (Resend, SES): artifact nay nam trong
         BOM spring-boot-dependencies 3.3.5 nen KHONG khai <version> va KHONG them property phien
         ban nao — dung ly do ADR 0003 da loai jjwt mot lan truoc do. Mot SDK ben ngoai BOM la them
         mot truc bao tri phai tu pin va tu theo doi.
         Khai o day chu khong o nss-controller: MailAppServiceImpl song o module nay, va Maven chi
         truyen dependency XUOI theo chieu phu thuoc. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- Resilience4j CircuitBreaker (backlog 0021 Phase 2, ADR 0005): breaker quanh duong gui SMTP.
         Dat o day chu khong o nss-controller vi MailAppServiceImpl song o module nay, va Maven chi
         truyen dependency XUOI theo chieu phu thuoc — thu khai o controller KHONG co tren classpath
         bien dich cua application. KHONG duoc keo xuong nss-domain (dao chieu phu thuoc,
         architecture muc 1); nss-domain khong duoc them canh phu thuoc nao trong ticket nay.
         Version do BOM resilience4j o root pom quan — KHONG khai <version> o day.
         CHI artifact circuitbreaker: no keo theo dung resilience4j-core + slf4j-api, khong cham
         Spring va khong cham actuator/micrometer (non-goal cua ticket). -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
    </dependency>
    <!-- spring-kafka (backlog 0032): KafkaTemplate cho OutboxPublisherJob (cronjob/) va @KafkaListener
         cho OrderStatusChangedConsumer (service/order/mq/) — ca hai song o module nay. Version do BOM
         spring-boot-dependencies 3.3.5 quan — khong khai <version>. Khai lai tuong minh du da co
         transitively qua nss-infrastructure (KafkaTopicConfig), dung tien le oauth2-resource-server:
         module nao dung thi module do tu khai. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- jackson-databind (backlog 0032): serialize/deserialize OrderStatusChangedMessage <-> JSON o
         OrderAppServiceImpl (ghi outbox_event.payload) va OrderStatusChangedConsumer (doc payload
         Kafka). Khac dong jackson-annotations o tren — day la ban dich thuc su, khong chi annotation.
         ObjectMapper duoc Spring Boot tu dung bean qua JacksonAutoConfiguration mien la class nay co
         mat tren classpath, khong can spring-boot-starter-web. Version do BOM spring-boot-dependencies
         3.3.5 quan — khong khai <version>. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- spring-boot-starter-thymeleaf (backlog 0032, Quyet dinh Owner 2): email trang thai don la
         HTML co dinh dang (bang san pham + badge mau), khac email quen-mat-khau plain text hien co.
         Dat o day vi MailAppServiceImpl.sendOrderStatusEmail song o module nay. Day la MO RONG STACK
         that su — Thymeleaf chua co ten trong bang stack architecture §2 o bat ky dang nao truoc
         ticket nay — nen architecture/01-overview.md §2 duoc cap nhat trong CUNG ticket nay, dung
         tien le mail o backlog 0017. Version do BOM spring-boot-dependencies 3.3.5 quan — khong khai
         <version>. Template resolver hoat dong khong can spring-boot-starter-web (ThymeleafAutoConfiguration
         khong phai cau hinh rieng cho web); file .html van dat o nss-start/src/main/resources vi
         "chi nss-start co src/main/resources" (architecture muc 1) — o mot jar da dong goi thi cac
         module khong con classloader rieng nen classpath:/templates/ van tim thay no luc chay. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
  </dependencies>
</project>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nss</groupId>
    <artifactId>nss-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>nss-application</artifactId>
  <name>nss-application</name>
  <description>Application: use case, dieu phoi giua domain va infrastructure.</description>

  <dependencies>
    <dependency>
      <groupId>com.nss</groupId>
      <artifactId>nss-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>com.nss</groupId>
      <artifactId>nss-infrastructure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- JwtEncoder / JwtClaimsSet de duc access token trong AuthAppServiceImpl (backlog 0010).
         Vi sao o day chu khong chi o nss-controller nhu ticket ghi: Maven chi truyen dependency
         XUOI theo chieu phu thuoc. nss-controller -> nss-application, nen thu khai o controller
         KHONG co tren classpath bien dich cua application. Ma use case cap phien (register /
         login / refresh) song o application, nen module do phai tu khai.
         nss-controller van khai lai ca hai starter mot cach tuong minh cho filter chain.
         Ca hai nam trong BOM spring-boot-dependencies 3.3.5 — khong khai <version>. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <!-- CHI annotation cua Jackson — khong phai databind, khong phai starter-json (backlog 0014
         phase 2).
         Vi sao module nay can no: cac lop *Response o day CHINH LA be mat day (ADR 0001 —
         controller tra DTO tran, khong boc ResultMessage), nen luat "truong nay VANG MAT khi khong
         ap dung" thuoc ve chinh dinh nghia cua DTO chu khong phai mot chi tiet cua tang HTTP.
         CartIssueResponse can @JsonInclude(NON_NULL) tren ba truong tuy chon: mot
         `availableStock: 0` gan tren issue price_changed la mot con so SAI, va con so sai thi
         frontend van hien thi duoc — no chi hien thi sai.
         KHONG dat NON_NULL toan cuc bang spring.jackson.default-property-inclusion: API_CONTRACT
         §A.5 bat "gia tri khong co" phai la `null` TUONG MINH, nen mot cau hinh toan cuc se lam
         `salePrice: null` cua ProductResponse bien mat va doi hinh dang cua type Product.
         Artifact nay chi mang annotation, khong keo theo bo tuan tu hoa nao; ban dich thuc su van
         den tu nss-controller qua spring-boot-starter-web. Version do BOM spring-boot-dependencies
         3.3.5 quan — khong khai <version>. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
  </dependencies>
</project>

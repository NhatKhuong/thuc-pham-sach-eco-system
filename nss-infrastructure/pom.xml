<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nss</groupId>
    <artifactId>nss-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>nss-infrastructure</artifactId>
  <name>nss-infrastructure</name>
  <description>Infrastructure: adapter cho cac port do domain khai bao.</description>

  <dependencies>
    <dependency>
      <groupId>com.nss</groupId>
      <artifactId>nss-domain</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <!-- Driver MySQL chi can luc chay, khong can luc bien dich -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- spring-kafka (backlog 0032, architecture/01-overview.md §6): KafkaTopicConfig (NewTopic bean)
         song o day, dung package config/ da co san. Version do BOM spring-boot-dependencies 3.3.5
         quan — khong khai <version>. nss-application khai lai tuong minh cho KafkaTemplate va
         @KafkaListener cua OutboxPublisherJob / OrderStatusChangedConsumer — dung tien le
         oauth2-resource-server o tren: Maven chi truyen dependency XUOI, module nao dung thi module
         do tu khai. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>
    <!-- Redis + Redisson (backlog 0035 Phase 0, architecture/01-overview.md §2/§4/§5) — thi hanh
         tai lieu: Redis 7.x + Redisson 3.17.1 da co ten trong bang stack tu truoc ticket nay, chua
         noi day. CHI module nay khai <dependency> that; nss-application KHONG them dependency Redis
         nao — no chi thay RedissonClient/StringRedisTemplate qua cac adapter (*CacheRedisAdapter,
         DistributedLockServiceImpl) song o day, dung tinh than "domain va application deu khong biet
         Redis ton tai" cua coding-conventions §13.
         spring-boot-starter-data-redis: Lettuce cho du lieu (Guava/Redis 3 tang doc, Lua atomic gate).
         Version do BOM spring-boot-dependencies 3.3.5 quan — khong khai <version>. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- org.redisson:redisson rieng cho distributed lock chong cache stampede (Phase 3) — KHONG dung
         chung client voi Lettuce (Redisson dung Netty rieng cua no). Version do root pom quan
         (dependencyManagement, khuon springdoc — mot <dependency> don, khong BOM rieng vi chi mot
         artifact). -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson</artifactId>
    </dependency>
  </dependencies>
</project>

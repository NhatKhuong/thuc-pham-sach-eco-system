<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.nss</groupId>
  <artifactId>nss-api</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>nss-api</name>
  <description>Bo xuong Maven multi-module DDD cho backend NSS</description>

  <!-- Thu tu module phan anh chieu phu thuoc: domain khong phu thuoc module nao -->
  <modules>
    <module>nss-domain</module>
    <module>nss-infrastructure</module>
    <module>nss-application</module>
    <module>nss-controller</module>
    <module>nss-start</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Import BOM spring-boot-dependencies, KHONG dung spring-boot-starter-parent (architecture/01-overview.md muc 2) -->
    <spring-boot.version>3.3.5</spring-boot.version>
    <!-- BOM spring-boot-dependencies KHONG quan version cua springdoc nen phai tu pin o day.
         2.6.0 la dong tuong thich Spring Boot 3.3.5 (backlog 0009) -->
    <springdoc.version>2.6.0</springdoc.version>
    <!-- BOM spring-boot-dependencies KHONG quan version cua Resilience4j nen phai tu pin o day, cung
         tien le voi springdoc (ADR 0005). 2.1.0 la con so architecture/01-overview.md muc 2 khai;
         bytecode major 61 (Java 17) nen chay duoc tren Java 21, va ca hai artifact dang dung
         (resilience4j-ratelimiter, resilience4j-circuitbreaker) chi keo theo resilience4j-core +
         slf4j-api - khong cham vao Spring, nen khong co truc tuong thich nao voi Spring Boot 3.3.5
         ngoai chinh Java. -->
    <resilience4j.version>2.1.0</resilience4j.version>
    <!-- BOM spring-boot-dependencies KHONG quan version cua Redisson nen phai tu pin o day
         (backlog 0035 Phase 0, architecture/01-overview.md §2). Redisson chi dung DUNG MOT artifact
         (org.redisson:redisson) nen pin theo khuon springdoc (mot <dependency> don trong
         dependencyManagement), KHONG import BOM rieng nhu resilience4j — BOM chi dang gia tri khi co
         >= 2 artifact cung dong can khoa chung mot version. 3.17.1 la con so architecture §2 da khai
         san trong bang stack tu truoc ticket nay, o day chi la lan dau pin no thanh <version> that. -->
    <redisson.version>3.17.1</redisson.version>
    <!-- Dong -jre (khong phai -android) — khop moi truong chay JVM cua du an. -->
    <guava.version>32.1.2-jre</guava.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>com.nss</groupId>
        <artifactId>nss-domain</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nss</groupId>
        <artifactId>nss-infrastructure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nss</groupId>
        <artifactId>nss-application</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nss</groupId>
        <artifactId>nss-controller</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- Chi nss-controller khai <dependency> that; o day chi pin version -->
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>

      <!-- Chi nss-infrastructure khai <dependency> that (backlog 0035 Phase 0); o day chi pin version,
           dung khuon voi springdoc o tren. -->
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson</artifactId>
        <version>${redisson.version}</version>
      </dependency>

      <!-- Guava 32.1.2-jre (architecture/01-overview.md §2) — L1 cache in-process cua backlog 0035
           Phase 1 (ProductCacheServiceImpl dung CacheBuilder). Khong nam trong BOM
           spring-boot-dependencies nen phai tu pin, cung tien le voi springdoc/redisson: mot
           <dependency> don. Chi nss-application khai <dependency> that — do la noi CacheBuilder
           duoc dung. -->
      <dependency>
        <groupId>com.google.guava</groupId>
        <artifactId>guava</artifactId>
        <version>${guava.version}</version>
      </dependency>

      <!-- Resilience4j: CHI hai module duoc khai <dependency> that — ratelimiter o nss-controller
           (bien vao, Phase 1) va circuitbreaker o nss-application (bien ra SMTP, Phase 2).
           KHONG dung resilience4j-spring-boot3: starter do keo theo AOP + actuator, ma
           Actuator/micrometer la non-goal cua backlog 0021 (mo mot public surface moi phai khoa
           RBAC). Ca hai cho deu dung API lap trinh nen khong can annotation lan autoconfiguration.
           VI SAO IMPORT BOM chu khong liet ke tung artifact: Phase 2 them artifact THU HAI cua
           cung mot dong. Moi the <version> viet them la mot cho NUA co the lech khi nang version,
           va hai artifact Resilience4j lech version nhau thi hong o cho khong ai nhin — chung dung
           chung resilience4j-core. BOM giu dung MOT the <version> cho ca dong, cung y do voi
           spring-boot-dependencies o tren. -->
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- Chi nss-start ap plugin nay; parent chi khai o pluginManagement -->
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
          <executions>
            <execution>
              <id>repackage</id>
              <goals>
                <goal>repackage</goal>
              </goals>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>

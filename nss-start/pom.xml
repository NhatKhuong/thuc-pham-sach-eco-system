<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.nss</groupId>
    <artifactId>nss-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>nss-start</artifactId>
  <name>nss-start</name>
  <description>Start: StartApplication va application.yml duy nhat cua toan he.</description>

  <properties>
    <!-- Test danh @Tag("db") can mot MySQL song nen bi loai khoi build mac dinh.
         Chay rieng: mvn -pl nss-start test -Dexcluded.test.groups= -Dgroups=db -->
    <excluded.test.groups>db</excluded.test.groups>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.nss</groupId>
      <artifactId>nss-controller</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- spring-kafka-test (backlog 0032 Phase 4): @EmbeddedKafka cho integration test toan luong
         outbox -> publish -> consume -> MailAppService, khong can container Kafka that. Version do
         BOM spring-boot-dependencies 3.3.5 quan — khong khai <version>. Test dung no danh @Tag("db")
         vi van can MySQL that cho Order/OutboxEvent/IdempotencyKey — cung lane voi cac test @Tag("db")
         khac, loai khoi build mac dinh. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <excludedGroups>${excluded.test.groups}</excludedGroups>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
